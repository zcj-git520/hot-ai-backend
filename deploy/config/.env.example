# ========================================
# AI热点追踪平台 - 环境变量配置
# ========================================
# 复制此文件为 .env 并修改相应的值

# ==================== MySQL 配置 ====================
MYSQL_ROOT_PASSWORD=root123
MYSQL_PASSWORD=hotai123
MYSQL_DATABASE=hot_ai
MYSQL_USER=hot_ai

# ==================== JWT 配置 ====================
# 生产环境请使用强密码！
JWT_SECRET=your-jwt-secret-key-change-in-production

# ==================== MongoDB 配置 ====================
MONGO_PASSWORD=root123

# ==================== Redis 配置 ====================
REDIS_PASSWORD=

# ==================== Grafana 配置 ====================
GRAFANA_PASSWORD=admin123

# ==================== 数据库连接 (容器间通信) ====================
DB_USER=hot_ai
DB_PASSWORD=hotai123

# ==================== 服务地址配置 ====================
CONTENT_SVC_URL=http://content-svc:8001
LEARNING_PATH_SVC_URL=http://learning-path-svc:8003

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_DIR=/var/log/hot-ai

# ==================== 缓存配置 ====================
REDIS_URL=redis:6379
